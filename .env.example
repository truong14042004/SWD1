# DenimFlow BO - Environment Configuration

# PostgreSQL Database Connection
# Example for Neon/Supabase/Local: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/denimflow_bo?schema=public"

# Application Port & Secret
PORT=3000
NODE_ENV="development"

# ==========================================
# CỔNG THANH TOÁN PAYOS (VIETQR)
# ==========================================
# Đăng ký & lấy thông tin kết nối tại https://my.payos.vn/
# Nếu chưa điền hoặc để trống, hệ thống tự động chạy chế độ Mô phỏng / Sandbox VietQR đầy đủ
PAYOS_CLIENT_ID="your_client_id_here"
PAYOS_API_KEY="your_api_key_here"
PAYOS_CHECKSUM_KEY="your_checksum_key_here"
